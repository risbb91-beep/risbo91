public abstract class Zivotinja
    {
        public string Naziv { get; set; }
        public string Boja { get; set; }
        public decimal Tezina { get; set; }

        public virtual void MetodaZvuk()
        {
            Console.WriteLine("Nepoznat zvuk");
        }

        public void MetodaPromenaTezine(decimal tezina)
        {
            Tezina = tezina;
        }
    }

    public class Pas:Zivotinja
    {
        public enum Rase
        {
            buldog,hrt,ovcar
        }
        public Rase Rasa { get; set; }

        public override void MetodaZvuk()
        {
            Console.WriteLine("Av-av");
        }
    }

    public class Ptica:Zivotinja
    {
        public bool Letenje { get; set; }

        public override void MetodaZvuk()
        {
            Console.WriteLine("Piju-piju");
        }
    }


    internal class Program
    {
        static void Main(string[] args)
        {
            Pas pas1 = new Pas();
            pas1.Naziv = "Kiki";
            pas1.Boja = "Crna";
            pas1.Tezina = 10;
            pas1.Rasa = Pas.Rase.ovcar;

            Pas pas2=new Pas();
            pas2.Naziv = "Maki";
            pas2.Boja = "Zuta";
            pas2.Tezina = 11;
            pas2.Rasa = Pas.Rase.buldog;

            Ptica pti=new Ptica();
            pti.Naziv = "Laki";
            pti.Boja = "Bela";
            pti.Tezina = 1;
            pti.Letenje = true;

            List<Zivotinja> zivlista = new List<Zivotinja>();
            zivlista.Add(pas1);
            zivlista.Add(pas2);
            zivlista.Add(pti);

            List<Zivotinja> zivlistasort = zivlista.OrderBy(z => z.Tezina).ToList();

            foreach (var z in zivlistasort)
            {
                Console.WriteLine(z.Naziv);
            }

            pas1.MetodaPromenaTezine(9);
            pas2.MetodaPromenaTezine(12);
            pti.MetodaPromenaTezine(2);

            pas1.MetodaZvuk();
            pas2.MetodaZvuk();
            pti.MetodaZvuk();

            Console.ReadKey();
        }
    }
