@model IEnumerable<Priprema.Models.Book>

@{
    ViewData["Title"] = "Sve Knjige";
}

<h2>Spisak svih knjiga</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Dodaj novu knjigu</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Naziv</th>
            <th>Naslov</th>
            <th>Autor</th>
            <th>Datum izdavanja</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Name</td>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PublishDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-warning">Izmeni</a> |
                    <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-danger" onclick="return confirm('Sigurno brišete?')">Obriši</a>
                </td>
            </tr>
        }
    </tbody>
</table>

