KORAK 8: Kreiranje BookController.cs (Kontroler)Desni klik na folder Controllers -> Add -> Class...Nazovi je BookController.cs i unesi sledeći kod:

using Microsoft.AspNetCore.Mvc;
using Priprema.Models;
using Priprema.Repository.Interface;

namespace Priprema.Controllers
{
    public class BookController : Controller
    {
        private readonly IBookRepository _repo;

        // Kontroler kroz konstruktor traži repozitorijum (Dependency Injection)
        public BookController(IBookRepository repo)
        {
            _repo = repo;
        }

        // 1. PRIKAZ SVIH KNJIGA (GET)
        public IActionResult Index()
        {
            var knjige = _repo.GetAllBooks();
            return View(knjige);
        }

        // 2. STRANICA ZA KREIRANJE KNJIIGE (Prikaz forme)
        public IActionResult Create()
        {
            return View();
        }

        // 3. SLANJE PODATAKA IZ FORME U BAZU (POST)
        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Create(Book book)
        {
            if (ModelState.IsValid)
            {
                _repo.CreateBook(book);
                return RedirectToAction(nameof(Index));
            }
            return View(book);
        }

        // 4. STRANICA ZA IZMENU KNJIGE (Prikaz forme sa starim podacima)
        public IActionResult Edit(int id)
        {
            var knjiga = _repo.GetBookByID(id);
            if (knjiga == null) return NotFound();
            return View(knjiga);
        }

        // 5. SLANJE IZMENJENIH PODATAKA U BAZU (POST/PUT)
        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Edit(int id, Book book)
        {
            if (ModelState.IsValid)
            {
                _repo.EditBook(id, book);
                return RedirectToAction(nameof(Index));
            }
            return View(book);
        }

        // 6. BRISANJE KNJIGE
        public IActionResult Delete(int id)
        {
            _repo.Delete(id);
            return RedirectToAction(nameof(Index));
        }
    }
}

