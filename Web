KORAK 4: Popravka i dopuna Program.cs fajlaPošto se tvoj kod u Program.cs prekinuo na pola, otvori taj fajl u svom projektu,
obriši sve iz njega i nalepi ovaj kompletan i ispravan kod:
using Microsoft.EntityFrameworkCore;
using Priprema.Data;
using Priprema.Repository.Impementation;
using Priprema.Repository.Interface;

var builder = WebApplication.CreateBuilder(args);

// 1. Registracija baze podataka
builder.Services.AddDbContext<BookDB>(opt =>
{
    opt.UseSqlServer(builder.Configuration.GetConnectionString("ConnectionString"));
});

// 2. Registracija repozitorijuma
builder.Services.AddScoped<IBookRepository, BookRepository>();

// 3. Podrška za MVC (Kontrolere i Poglede)
builder.Services.AddControllersWithViews();

var app = builder.Build();

// Konfiguracija HTTP zahteva
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseStaticFiles();

app.UseRouting();

app.UseAuthorization();

// 4. Definisanje početne stranice (Kada se pokrene aplikacija, otvara se Book kontroler)
app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Book}/{action=Index}/{id?}");

app.Run();

