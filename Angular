import { Component, Inject, OnInit } from '@angular/core';
import { FormBuilder, FormGroup, Validators, ReactiveFormsModule } from '@angular/forms';
import { MatDialogRef, MAT_DIALOG_DATA, MatDialogModule } from '@angular/material/dialog';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatButtonModule } from '@angular/material/button';
import { Podatak } from '../../modeli/podatak.model';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-forma-podatak',
  standalone: true,
  imports: [CommonModule, MatDialogModule, MatFormFieldModule, MatInputModule, MatButtonModule, ReactiveFormsModule],
  templateUrl: './forma-podatak.component.html',
  styleUrls: ['./forma-podatak.component.css']
})
export class FormaPodatakComponent implements OnInit {
  forma!: FormGroup;

  constructor(
    private fb: FormBuilder,
    private dialogRef: MatDialogRef<FormbaPodatakComponent>,
    @Inject(MAT_DIALOG_DATA) public data: Podatak
  ) {}

  ngOnInit(): OnInit {
    this.forma = this.fb.group({
      naziv: [this.data ? this.data.naziv : '', Validators.required],
      kategorija: [this.data ? this.data.kategorija : '', Validators.required]
    });
  }

  sacuvaj() {
    if (this.forma.valid) {
      this.dialogRef.close(this.forma.value);
    }
  }

  zatvori() {
    this.dialogRef.close();
  }
}

