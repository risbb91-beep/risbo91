Na kraju, povežite sve u src/app/komponente/prikaz-podataka/prikaz-podataka.component.ts:

import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { MatDialog, MatDialogModule } from '@angular/material/dialog';
import { MatButtonModule } from '@angular/material/button';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatIconModule } from '@angular/material/icon';

import { SifarnikService } from '../../servisi/sifarnik.service';
import { Podatak } from '../../modeli/podatak.model';
import { FiltriranjePipe } from '../../pipe/filtriranje.pipe';
import { DijalogPotvrdaComponent } from '../dijalog-potvrda/dijalog-potvrda.component';
import { FormaPodatakComponent } from '../forma-podatak/forma-podatak.component';

@Component({
  selector: 'app-prikaz-podataka',
  standalone: true,
  imports: [
    CommonModule, FormsModule, MatDialogModule, MatButtonModule, 
    MatFormFieldModule, MatInputModule, MatIconModule, FiltriranjePipe
  ],
  templateUrl: './prikaz-podataka.component.html',
  styleUrls: ['./prikaz-podataka.component.css']
})
export class PrikazPodatakaComponent implements OnInit {
  listaPodataka: Podatak[] = [];
  tekstPretrage: string = '';

  constructor(private service: SifarnikService, private dialog: MatDialog) {}

  ngOnInit(): void {
    this.ucitajSvePodatke();
  }

  // GET poziv
  ucitajSvePodatke() {
    this.service.getPodaci().subscribe({
      next: (data) => this.listaPodataka = data,
      error: (err) => console.error('Greška pri učitavanju podataka', err)
    });
  }

  // POST i PUT poziv kroz istu modalnu formu
  otvoriFormu(podatak?: Podatak) {
    const dialogRef = this.dialog.open(FormaPodatakComponent, {
      width: '400px',
      data: podatak ? { ...podatak } : null
    });

    dialogRef.afterClosed().subscribe(rezultat => {
      if (rezultat) {
        if (podatak && podatak.id) {
          // Izmena postojećeg podatka (PUT)
          this.service.izmeniPodatak(podatak.id, rezultat).subscribe(() => this.ucitajSvePodatke());
        } else {
          // Dodavanje novog podatka (POST)
          this.service.dodajPodatak(rezultat).subscribe(() => this.ucitajSvePodatke());
        }
      }
    });
  }

  // DELETE poziv sa modalnom potvrdom
  potvrdiBrisanje(podatak: Podatak) {
    const dialogRef = this.dialog.open(DijalogPotvrdaComponent);

    dialogRef.afterClosed().subscribe(potvrdjeno => {
      if (potvrdjeno && podatak.id) {
        this.service.obrisiPodatak(podatak.id).subscribe(() => {
          this.ucitajSvePodatke(); // Osveži tabelu nakon brisanja
        });
      }
    });
  }
}
