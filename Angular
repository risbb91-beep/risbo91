Sada podesite src/app/servisi/sifarnik.service.ts koji izvršava GET, POST, PUT i DELETE metode:

import { Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';
import { Podatak } from '../modeli/podatak.model';

@Injectable({
  providedIn: 'root'
}}
export class SifarnikService {
  // Promenite URL u vaš stvarni REST API endpoint sa udaljenog servera
  private apiUrl = 'https://primer-servera.com'; 

  constructor(private http: HttpClient) {}

  // GET metoda za dohvatanje podataka
  getPodaci(): Observable<Podatak[]> {
    return this.http.get<Podatak[]>(this.apiUrl);
  }

  // POST metoda za dodavanje novog podatka
  dodajPodatak(podatak: Podatak): Observable<Podatak> {
    return this.http.post<Podatak>(this.apiUrl, podatak);
  }

  // PUT metoda za izmenu postojećeg podatka
  izmeniPodatak(id: number, podatak: Podatak): Observable<Podatak> {
    return this.http.put<Podatak>(`${this.apiUrl}/${id}`, podatak);
  }

  // DELETE metoda za brisanje podatka
  obrisiPodatak(id: number): Observable<void> {
    return this.http.delete<void>(`${this.apiUrl}/${id}`);
  }
}


Korak 7: Kreiranje prilagođenog Pipe-a za filtriranje dve kolonePravimo logiku koja filtrira i kolonu naziv i kolonu kategorija.
Otvorite src/app/pipe/filtriranje.pipe.ts:

import { Pipe, PipeTransform } from '@angular/core';
import { Podatak } from '../modeli/podatak.model';

@Pipe({
  name: 'filtriranje',
  standalone: true
})
export class FiltriranjePipe implements PipeTransform {
  transform(podaci: Podatak[], tekstZaPretragu: string): Podatak[] {
    if (!podaci || !tekstZaPretragu) {
      return podaci;
    }
    
    const pretraga = tekstZaPretragu.toLowerCase();
    
    // Filtriranje obuhvata dve kolone: naziv i kategorija
    return podaci.filter(p => 
      p.naziv.toLowerCase().includes(pretraga) || 
      p.kategorija.toLowerCase().includes(pretraga)
    );
  }
}

