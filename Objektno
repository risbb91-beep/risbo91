using System;
using System.Collections.Generic;
using System.IO;
using StudentApp; // Uvozimo projekat StudentApp radi korišćenja klase Student

namespace DataLayer
{
    public class TextRepository : ITextRepository
    {
        // Tekstualni fajl će se čuvati u bin/Debug folderu projekta
        private readonly string filePath = "studenti.txt";

        public TextRepository()
        {
            // Ako fajl ne postoji na disku, kreiramo ga pri pokretanju programa
            if (!File.Exists(filePath))
            {
                File.Create(filePath).Close();
            }
        }

        // 1. Čitanje svih studenata iz tekstualnog fajla
        public List<Student> GetStudent()
        {
            List<Student> lista = new List<Student>();
            string[] sveLinije = File.ReadAllLines(filePath);

            foreach (string linija in sveLinije)
            {
                if (string.IsNullOrWhiteSpace(linija)) continue;

                // Delimo tekst po znaku tačka-zapeta (;) prema formatu: 001;Pera;Peric
                string[] delovi = linija.Split(';');
                if (delovi.Length == 3)
                {
                    Student s = new Student
                    {
                        IndexNumber = delovi[0],
                        FirstName = delovi[1],
                        LastName = delovi[2]
                    };
                    lista.Add(s);
                }
            }
            return lista;
        }

        // 2. Pretraga studenta na osnovu broja indeksa
        public Student GetStudent(string indexNumber)
        {
            List<Student> sviStudenti = GetStudent();
            foreach (Student s in sviStudenti)
            {
                if (s.IndexNumber == indexNumber)
                {
                    return s; // Student je pronađen
                }
            }
            return null; // Vraća null ukoliko student ne postoji
        }

        // 3. Dodavanje novog studenta u tekstualni fajl
        public bool AddStudent(Student s)
        {
            // Validacija: Sprečavamo upis ukoliko indeks već postoji u fajlu
            if (GetStudent(s.IndexNumber) != null)
            {
                return false; 
            }

            // Formatiranje linije za upis
            string novaLinija = $"{s.IndexNumber};{s.FirstName};{s.LastName}";
            File.AppendAllLines(filePath, new List<string> { novaLinija });
            return true;
        }

        // 4. Brisanje studenta iz tekstualnog fajla preko indeksa
        public bool DeleteStudent(string indexNumber)
        {
            List<Student> sviStudenti = GetStudent();
            bool obrisan = false;
            List<string> noveLinije = new List<string>();

            foreach (Student s in sviStudenti)
            {
                if (s.IndexNumber == indexNumber)
                {
                    obrisan = true;
                    continue; // Preskačemo ovog studenta (brišemo ga)
                }
                noveLinije.Add($"{s.IndexNumber};{s.FirstName};{s.LastName}");
            }

            if (obrisan)
            {
                // Prepisujemo fajl novim podacima (bez obrisanog studenta)
                File.WriteAllLines(filePath, noveLinije);
            }
            return obrisan;
        }
    }
}

