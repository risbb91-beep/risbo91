using System;
using System.Collections.Generic;
using DataLayer; // Uvozimo naš Class Library sloj podataka

namespace StudentApp
{
    class Program
    {
        static void Main(string[] args)
        {
            // Instanciranje repozitorijuma preko interfejsa (Dobra arhitektonska praksa)
            ITextRepository repo = new TextRepository();

            Console.WriteLine("=== 1. AUTOMATSKO PUNJENJE I TEST DODAVANJA ===");
            
            Student s1 = new Student("001", "Pera", "Peric");
            Student s2 = new Student("002", "Ana", "Anic");
            Student s3 = new Student("003", "Marko", "Markovic");

            UpisiIObavesti(repo, s1);
            UpisiIObavesti(repo, s2);
            UpisiIObavesti(repo, s3);


            Console.WriteLine("\n=== 2. TRENUTNI ISPIS SVIH STUDENATA IZ FAJLA ===");
            IspisiSveIzFajla(repo);


            Console.WriteLine("\n=== 3. ZAHTEV ZADATKA: PRETRAGA PO INDEKSU ===");
            Console.Write("Unesite broj indeksa studenta kojeg tražite: ");
            string unosIndeksa = Console.ReadLine();

            // Poziv metode za pretragu
            Student trazeniStudent = repo.GetStudent(unosIndeksa);

            // LOGIKA IZ TEKSTA ZADATKA: Isčitavanje i provera postojanja
            if (trazeniStudent != null)
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine($"[USPEH]: Pronađen student -> {trazeniStudent}");
                Console.ResetColor();
            }
            else
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"[OBAVEŠTENJE]: Student sa brojem indeksa '{unosIndeksa}' ne postoji u bazi!");
                Console.ResetColor();
            }


            Console.WriteLine("\n=== 4. TESTIRANJE METODE BRISANJA ===");
            Console.Write("Unesite broj indeksa za brisanje: ");
            string indeksZaBrisanje = Console.ReadLine();

            if (repo.DeleteStudent(indeksZaBrisanje))
            {
                Console.WriteLine($"Student sa indeksom {indeksZaBrisanje} je uspešno uklonjen iz fajla.");
            }
            else
            {
                Console.WriteLine("Greška. Student sa tim indeksom nije pronađen.");
            }


            Console.WriteLine("\n=== 5. KONAČNO STANJE U TEKSTUALNOM FAJLU ===");
            IspisiSveIzFajla(repo);

            // Čuvanje prozora konzole otvorenim
            Console.ReadLine();
        }

        // Pomoćna metoda za ispis obaveštenja o uspešnosti upisa
        static void UpisiIObavesti(ITextRepository repo, Student s)
        {
            if (repo.AddStudent(s))
            {
                Console.WriteLine($"Dodat u fajl: {s.FirstName} {s.LastName} ({s.IndexNumber})");
            }
            else
            {
                Console.WriteLine($"Preskočeno: Student sa indeksom {s.IndexNumber} već postoji.");
            }
        }

        // Pomoćna metoda za čitanje cele liste i štampanje u konzoli
        static void IspisiSveIzFajla(ITextRepository repo)
        {
            List<Student> trenutniStudenti = repo.GetStudent();
            if (trenutniStudenti.Count == 0)
            {
                Console.WriteLine("Fajl je prazan.");
            }
            else
            {
                foreach (Student s in trenutniStudenti)
                {
                    Console.WriteLine(s);
                }
            }
        }
    }
}

